# Copiar a .env (ignorado por git). Nunca subir valores reales al repositorio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Para usar S3 como storage del pipeline (requiere `uv sync --extra s3`):
# GASOLINA_BASE_URI=s3://<bucket>/<equipo>

# s3-sync (perfil s3 de compose.yaml)
S3_BUCKET=
S3_PREFIX=equipo01/monitoreo
SYNC_INTERVAL=300
